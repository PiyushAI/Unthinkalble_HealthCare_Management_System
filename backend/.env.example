# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_URL="http://localhost:3000"

# ── Database (Supabase Postgres connection string) ──────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── Supabase Auth ─────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-side only, keep secret

# ── Redis / BullMQ (Optional: Upstash free tier works well) ───────────────
# Upstash Dashboard → your DB → "Redis Connect" URL (rediss:// with TLS)
REDIS_URL="rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379"

# ── LLM (Google AI Studio Gemini / Anthropic) ─────────────────────────────
# Google AI Studio: aistudio.google.com → Get API key
GEMINI_API_KEY="AIzaSy..."
# Anthropic: console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Email (Resend) ───────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY="re_..."
EMAIL_FROM="MediFlow <appointments@yourdomain.com>"

# ── Google Calendar OAuth 2.0 ────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
# Enable "Google Calendar API", create OAuth Client ID (Web application)
# Add Authorized Redirect URI: http://localhost:4000/auth/google/calendar/callback
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/calendar/callback"

# ── Encryption (for storing Google refresh tokens at rest) ───────────────
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="replace-with-a-64-char-hex-string"
